<?xml version="1.0" encoding="utf-8"?><!-- 画布卡片：内嵌感——上缘暗线背光、下缘亮线受光、卡面略深于画布 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 上内阴影：比卡面深一档，从顶部露出 1dp -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#DCE0E6" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 下内高光：比画布亮一档，从底部露出 1dp -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FAFBFC" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 主卡面：略深于画布 #F1F2F4，上下各收 1dp 露出边缘线 -->
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#EDEFF3" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
